
DirectorySlash Off
RewriteEngine on
Options -MultiViews
RewriteCond %{THE_REQUEST} "\s/+index\.php[?\s]" [NC]
RewriteRule ^index\.php$ / [R=301,L]
RewriteRule ^live\.php$ /event [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+live_grid\.php[?\s]" [NC]
RewriteRule ^live_grid\.php$ /events [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+(releases|release|events|event|videos|lyrics)\.php[?\s]" [NC]
RewriteRule ^(releases|release|events|event|videos|lyrics)\.php$ /$1 [R=301,L]
RewriteRule ^(releases|release|events|event|videos|lyrics)/$ /$1 [R=301,L]
RewriteRule ^(releases|release|events|event|videos|lyrics)$ $1.php [END]
RewriteRule ^data(?:/|$) - [F,L]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteCond %{HTTP_HOST} ^silentlab\.net$ [OR]
RewriteCond %{HTTP_HOST} ^www\.silentlab\.net$
RewriteRule ^/?$ "https\:\/\/silentlab\.net\/" [R=301,L]
